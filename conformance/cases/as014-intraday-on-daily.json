{
  "description": "DAY_HIGH needs intraday bars; on a 1d strategy it has nothing to measure.",
  "document": {
    "contractVersion": "0.1",
    "kind": "artifact",
    "title": "EMA 20/60 crossover",
    "note": "The smallest useful artifact: two indicators, one entry, one exit, a fixed symbol list.",
    "market": "us_equity",
    "timeframe": "1d",
    "dsl": {
      "version": 1,
      "indicators": {
        "fast": {
          "type": "EMA",
          "period": 20
        },
        "slow": {
          "type": "EMA",
          "period": 60
        },
        "dayHigh": {
          "type": "DAY_HIGH"
        }
      },
      "entry": {
        "type": "AND",
        "left": {
          "type": "CROSS_UP",
          "left": {
            "ind": "fast"
          },
          "right": {
            "ind": "slow"
          }
        },
        "right": {
          "type": "GT",
          "left": {
            "ind": "fast"
          },
          "right": {
            "ind": "dayHigh"
          }
        }
      },
      "exit": {
        "type": "CROSS_DOWN",
        "left": {
          "ind": "fast"
        },
        "right": {
          "ind": "slow"
        }
      }
    },
    "universe": {
      "mode": "SYMBOLS",
      "symbols": [
        "AAPL",
        "MSFT",
        "NVDA"
      ]
    },
    "riskProfile": {
      "maxSymbolExposurePct": 20,
      "maxTotalExposurePct": 60
    },
    "producer": {
      "kind": "HUMAN",
      "name": "example"
    }
  },
  "expect": {
