{
  "description": "Two indicators that reference each other.",
  "document": {
    "contractVersion": "0.1",
    "kind": "artifact",
    "title": "EMA 20/60 crossover",
    "note": "The smallest useful artifact: two indicators, one entry, one exit, a fixed symbol list.",
    "market": "us_equity",
    "timeframe": "1d",
    "dsl": {
      "version": 1,
      "indicators": {
        "fast": {
          "type": "EMA",
          "period": 20
        },
        "slow": {
          "type": "EMA",
          "period": 60
        },
        "a": {
          "type": "SUB",
          "left": {
            "ind": "b"
          },
          "right": {
            "ind": "fast"
          }
        },
        "b": {
          "type": "ADD",
          "left": {
            "ind": "a"
          },
          "right": {
            "const": 1
          }
        }
      },
      "entry": {
        "type": "CROSS_UP",
        "left": {
          "ind": "fast"
        },
        "right": {
          "ind": "slow"
        }
      },
      "exit": {
        "type": "LT",
        "left": {
          "ind": "a"
        },
        "right": {
          "const": 0
        }
      }
    },
    "universe": {
      "mode": "SYMBOLS",
      "symbols": [
        "AAPL",
        "MSFT",
        "NVDA"
      ]
    },
    "riskProfile": {
      "maxSymbolExposurePct": 20,
      "maxTotalExposurePct": 60
    },
    "producer": {
      "kind": "HUMAN",
      "name": "example"
    }
  },
  "expect": {
    "valid": false,
    "errors": [
      "AS004"
    ],
    "warnings": []
  }
}
